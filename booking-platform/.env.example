# Copy to .env.local; never commit actual credentials.
DATABASE_URL=
POSTGRES_PASSWORD=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Generate a random secret of at least 32 characters. Use HTTPS in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TRIPJACK_FLIGHT_API_KEY=
TRIPJACK_HOTEL_API_KEY=
CRM_EVENTS_URL=
CRM_SIGNING_KEY=
CRM_KEY_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TRAVELLER_ENCRYPTION_KEY=
# Random 32-byte AES key expressed as 64 hexadecimal characters; preserve for decryption.

REFUND_SECOND_APPROVAL_MINOR=5000000
# Production application DATABASE_URL should use restricted maxtravel_app role.
# Keep migration owner credentials in a separate private .env.migration file.

# Optional two-way CRM commands: distinct secret from CRM_SIGNING_KEY
CRM_COMMAND_KEYS={}
CRM_STAFF_ACTORS={}
