import { tripjack } from "../src/lib/providers/tripjack";
import { database } from "../src/lib/db";
import { z } from "zod";
const record=z.object({cityRegionId:z.union([z.number().int(),z.string().regex(/^\d+$/)]),cityName:z.string().min(1),countryName:z.string().min(1),fullRegionName:z.string().min(1)});
try{let cursor:string|undefined;let pages=0;do{const result=await tripjack("HOTEL","/hms/v3/content/fetch-city-regionIds?limit=2000"+(cursor?`&cursor=${encodeURIComponent(cursor)}`:""),undefined,false,"GET");const rows=z.array(record).parse(result.hotelCityRegionIds);const client=await database().connect();try{await client.query("BEGIN");for(const row of rows)await client.query("INSERT INTO hotel_destinations(region_id,name,country,label) VALUES($1,$2,$3,$4) ON CONFLICT(region_id) DO UPDATE SET name=excluded.name,country=excluded.country,label=excluded.label,updated_at=now()",[String(row.cityRegionId),row.cityName,row.countryName,row.fullRegionName]);await client.query("COMMIT");}catch(e){await client.query("ROLLBACK");throw e;}finally{client.release();}console.log("Destination catalogue page saved",{page:++pages,count:rows.length});if(result.hasMore&&(!result.nextCursor||result.nextCursor===cursor))throw Error("Invalid catalogue cursor");cursor=result.hasMore?String(result.nextCursor):undefined;if(pages>2000)throw Error("Catalogue pagination exceeded safe limit");}while(cursor);}finally{await database().end();}
