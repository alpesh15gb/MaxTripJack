{
  "name": "booking-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:workers": "esbuild scripts/booking-worker.mts scripts/crm-worker.mts scripts/notification-worker.mts scripts/migrate-auth.mts scripts/sync-catalogue.mts scripts/refund-worker.mts scripts/maintenance-worker.mts scripts/cancellation-worker.mts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx tests/integration.mts",
    "test:providers": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx tests/provider-flow.mts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:auth": "node --env-file=.env.local --import tsx scripts/migrate-auth.mts",
    "worker:crm": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/crm-worker.mts",
    "worker:bookings": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/booking-worker.mts",
    "worker:notifications": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/notification-worker.mts",
    "catalogue:sync": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/sync-catalogue.mts",
    "worker:refunds": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/refund-worker.mts",
    "test:refunds": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx tests/refund-flow.mts",
    "test:security-production": "node tests/production-security.mjs",
    "release:check": "node --env-file=.env.production scripts/release-check.mjs",
    "worker:maintenance": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/maintenance-worker.mts",
    "worker:cancellations": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx scripts/cancellation-worker.mts",
    "test:cancellations": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx tests/cancellation-flow.mts",
    "test:flight-services": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx tests/flight-services-flow.mts",
    "test:checkout": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx tests/checkout-flow.mts",
    "test:crm-commands": "node --env-file=.env.local --conditions=react-server --import ./scripts/standalone-server.mjs --import tsx tests/crm-commands-flow.mts",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "better-auth": "^1.7.7",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
